**/config/local.yaml
**/config/*.local.yaml

# Generated by Cargo
# will have compiled files and executables
debug/
target/

# include cargo lock
!Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

*.sqlite
*.sqlite-*

# Local environment and editor files
.env
.env.*
.DS_Store
.idea/
.vscode/

# TypeScript bindings generated by ts-rs when tests run (the API contract format for the
# separate frontend repo is still to be decided)
bindings/
